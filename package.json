{
  "name": "tpr-cards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TPR (Total Physical Response) command cards - an offline-first PWA for language teachers",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/resize-cards.mjs && node scripts/package-cards.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/core": "^13.6.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vue-tsc": "^3.0.6",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.5.1"
}
